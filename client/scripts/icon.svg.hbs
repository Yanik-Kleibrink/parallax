<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width="100"
  height="100"
>
  <circle
    cx="50"
    cy="50"
    r="32"
    fill="currentColor"
    mask="url(#iconMask_{{id}})"
  />

  <circle
    cx="50"
    cy="50"
    r="40"
    fill="none"
    stroke="currentColor"
    stroke-width="8"
    stroke-dasharray="{{patternOutside}}"
    stroke-dashoffset="{{offsetOutside}}"
    transform="rotate(-90 50 50)"
    stroke-linecap="round"
    mask="url(#progressMask_{{id}})"
  />
  <mask id="progressMask_{{id}}" mask-type="luminance">
    <rect x="0" y="0" width="100" height="100" fill="white"></rect>
    <circle
      cx="50"
      cy="50"
      r="40"
      fill="none"
      stroke="black"
      stroke-width="4"
      stroke-dasharray="{{patternInside}}"
      stroke-dashoffset="{{offsetInside}}"
      stroke-linecap="round"
    />
  </mask>
  {{#if notEmpty}}
    <circle
      cx="50"
      cy="50"
      r="40"
      fill="none"
      stroke="currentColor"
      stroke-width="8"
      stroke-dasharray="{{patternProgress}}"
      stroke-dashoffset="{{offsetOutside}}"
      transform="rotate(-90 50 50)"
      stroke-linecap="round"
    />
  {{/if}}

  <mask id="iconMask_{{id}}" mask-type="luminance">
    <rect x="0" y="0" width="100" height="100" fill="white"></rect>
    <g transform="translate(30 30) scale(2.5)" color="black">
      {{{icon}}}
    </g>
  </mask>

</svg>